{
  "name": "homebridge-ness-d16x-cg",
  "description": "Homebridge Ness D16 v2 with garage-door output support",
  "version": "2.1.3",
  "license": "MIT",
  "engines": {
    "node": ">=18.16.0",
    "homebridge": ">=1.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGE.md",
    "LICENSE",
    "readme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "build": "rimraf ./dist && tsc",
    "prepare": "echo \"skip build on git install\"",
    "prepack": "npm run lint && npm run build",
    "prepublishOnly": "npm run lint"
  },
  "keywords": [
    "homebridge-plugin",
    "Ness",
    "D8",
    "D8x",
    "D16",
    "D16x"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christopherguzik/homebridge-ness-d16x.git"
  },
  "bugs": {
    "url": "https://github.com/christopherguzik/homebridge-ness-d16x/issues"
  },
  "dependencies": {
    "nessclient": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@typescript-eslint/eslint-plugin": "^5.23.0",
    "@typescript-eslint/parser": "^5.23.0",
    "eslint": "^8.15.0",
    "homebridge": "^1.3.9",
    "rimraf": "^3.0.2",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.4"
  }
}
